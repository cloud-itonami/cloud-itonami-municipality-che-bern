(ns culture.facts-test
  (:require [kotoba.lang.edn :as edn]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is]]
            [culture.facts :as facts]))

(deftest bern-has-culture-basis
  (let [sb (facts/spec-basis "bern")]
    (is (= 8 (count sb)))
    (is (= (count sb) (count (set (map :culture/id sb)))))
    (is (every? #(str/starts-with? (:culture/url %) "https://") sb))
    (is (every? #(= "bern" (:culture/municipality %)) sb))
    (is (every? #(= "CHE" (:culture/country %)) sb))
    (is (every? #(seq (:culture/summary %)) sb))
    (is (every? #(string? (:culture/retrieved-at %)) sb))))

(deftest unknown-municipality-has-no-basis
  (is (nil? (facts/spec-basis "zurich")))
  (is (nil? (facts/spec-basis "zzz"))))

(deftest coverage-is-honest
  (let [c (facts/coverage ["bern" "zurich"])]
    (is (= 2 (:requested c)))
    (is (= 1 (:covered c)))
    (is (= ["zurich"] (:missing-municipalities c)))))

(deftest by-kind-filters
  (is (= 3 (count (facts/by-kind "bern" :dish))))
  (is (= ["bern.festival.zibelemaerit"]
         (mapv :culture/id (facts/by-kind "bern" :festival))))
  (is (empty? (facts/by-kind "bern" :beverage)))
  (is (empty? (facts/by-kind "zurich" :dish))))

(deftest tx-file-matches-catalog
  (let [tx (edn/read-string (slurp "data/culture-tx.edn"))
        flat (mapcat val (sort-by key facts/catalog))]
    (is (= (vec flat) (vec tx)))))
